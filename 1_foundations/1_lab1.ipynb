    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"<table style=\\\"margin: 0; text-align: left; width:100%\\\">\\n\",\n",
    "    \"    <tr>\\n\",\n",
    "    \"        <td style=\\\"width: 150px; height: 150px; vertical-align: middle;\\\">\\n\",\n",
