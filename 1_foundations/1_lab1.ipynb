    "    }\n",
    "   ],\n",
    "   \"source\": [\n",
    "    \"# Next it's time to load the API keys into environment variables\\n\",\n",
    "    \"# If this returns false, see the next cell!\\n\",\n",
    "    \"\\n\",\n",
    "    \"load_dotenv(override=True)\"\n",
