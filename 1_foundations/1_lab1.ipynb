    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# First let's do an import. If you get an Import Error, double check that your Kernel is correct..\\n\",\n",
    "    \"\\n\",\n",
    "    \"from dotenv import load_dotenv\\n\"\n",
    "   ]\n",
