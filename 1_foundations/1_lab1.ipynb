    "   ],\n",
    "   \"source\": [\n",
    "    \"from IPython.display import Markdown, display\\n\",\n",
    "    \"import openai\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Configuration\\n\",\n",
    "    \"MODEL = \\\"gpt-4.1-mini\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def ask_openai(prompt):\\n\",\n",
    "    \"    response = openai.chat.completions.create(\\n\",\n",
    "    \"        model=MODEL,\\n\",\n",
    "    \"        messages=[{\\\"role\\\": \\\"user\\\", \\\"content\\\": prompt}]\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    return response.choices[0].message.content\\n\",\n",
    "    \"\\n\",\n",
    "    \"def show_markdown(title, content):\\n\",\n",
    "    \"    print(f\\\"\\\\n{title}:\\\")\\n\",\n",
    "    \"    display(Markdown(content))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Step 1: Get a promising business area\\n\",\n",
    "    \"business_area_prompt = \\\"Pick a business area that might be worth exploring for an Agentic AI opportunity.\\\"\\n\",\n",
    "    \"business_area = ask_openai(business_area_prompt)\\n\",\n",
    "    \"show_markdown(\\\"Business Area\\\", business_area)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Step 2: Identify key pain points\\n\",\n",
    "    \"pain_points_prompt = f\\\"Based on the business area of {business_area}, identify key pain points or challenges in this industry that could benefit from an Agentic AI solution.\\\"\\n\",\n",
    "    \"pain_points = ask_openai(pain_points_prompt)\\n\",\n",
    "    \"show_markdown(\\\"Pain Points\\\", pain_points)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# And repeat! In the next message, include the business idea within the message\"\n",
    "    \"# Step 3: Propose an Agentic AI solution\\n\",\n",
    "    \"solution_prompt = (\\n\",\n",
    "    \"    f\\\"Based on the business area of {business_area} and the identified pain points: {pain_points}, \\\"\\n\",\n",
    "    \"    \\\"propose a specific Agentic AI solution that could address these challenges. \\\"\\n\",\n",
    "    \"    \\\"Include key features and potential benefits.\\\"\\n\",\n",
    "    \")\\n\",\n",
    "    \"ai_solution = ask_openai(solution_prompt)\\n\",\n",
    "    \"show_markdown(\\\"Proposed AI Solution\\\", ai_solution)\\n\"\n",
    "   ]\n",
